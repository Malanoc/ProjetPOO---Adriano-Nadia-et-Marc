@page
@model Movie_Library.Pages.Movies.IndexModel

@{
    ViewData["Title"] = "Films";
}

<div class="container py-5">

    <div class="mb-5">

        <span class="home-kicker">
            Cinéma
        </span>

        <h1 class="display-5 fw-bold">
            Rechercher un film
        </h1>

        <p class="text-muted">
            Trouvez un film sur TMDB et ajoutez-le à votre bibliothèque.
        </p>

    </div>


    <!-- RECHERCHE -->

    <form method="get" class="mb-5">

        <div class="row g-2">

            <div class="col">

                <input type="text"
                       name="SearchTerm"
                       value="@Model.SearchTerm"
                       class="form-control"
                       placeholder="Ex. Inception, The Batman..."
                       autocomplete="off" />

            </div>

            <div class="col-auto">

                <button type="submit"
                        class="btn btn-primary">

                    Rechercher

                </button>

            </div>

        </div>

    </form>


    <!-- MESSAGE -->
    @if (!string.IsNullOrWhiteSpace(Model.Message))
    {
        <div class="alert alert-secondary mb-4">

            @Model.Message

        </div>
    }


    <!-- RESULTATS -->
    @if (!string.IsNullOrWhiteSpace(Model.SearchTerm))
    {
        <div class="mb-4">

            <h2 class="h4">
                Résultats pour « @Model.SearchTerm »
            </h2>

        </div>


        @if (Model.FoundMovies.Count == 0 &&
             Model.AlreadyInLibrary.Count == 0)
        {
            <div class="library-empty">

                <h2 class="h4">
                    Aucun film trouvé
                </h2>

                <p>
                    Aucun résultat ne correspond à votre recherche.
                </p>

            </div>
        }
        else
        {
            <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 g-4">

                @foreach (var movie in Model.FoundMovies)
                {
                    <div class="col">

                        <article class="movie-card">

                            <div class="movie-poster">

                                @if (!string.IsNullOrWhiteSpace(movie.Poster))
                                {
                                    <img src="@movie.Poster"
                                         alt="@movie.Title"
                                         loading="lazy" />
                                }
                                else
                                {
                                    <div class="movie-poster-placeholder">
                                        Pas d'affiche
                                    </div>
                                }

                            </div>

                            <div class="movie-info">

                                <h3 class="movie-title">
                                    @movie.Title
                                </h3>

                                <div class="movie-meta">

                                    <span>
                                        TMDB
                                    </span>

                                    <span class="movie-rating">
                                        @movie.RatingTMDB.ToString("0.0") / 10
                                    </span>

                                </div>

                                <p class="mt-3">
                                    @movie.Synopsis
                                </p>


                                <form method="post"
                                      asp-page-handler="Add">

                                    <input type="hidden"
                                           name="id"
                                           value="@movie.Id" />

                                    <input type="hidden"
                                           name="title"
                                           value="@movie.Title" />

                                    <input type="hidden"
                                           name="synopsis"
                                           value="@movie.Synopsis" />

                                    <input type="hidden"
                                           name="poster"
                                           value="@movie.Poster" />

                                    <input type="hidden"
                                           name="ratingTMDB"
                                           value="@movie.RatingTMDB" />

                                    <input type="hidden"
                                           name="searchTerm"
                                           value="@Model.SearchTerm" />

                                    <button type="submit"
                                            class="btn btn-primary w-100">

                                        Ajouter à ma bibliothèque

                                    </button>

                                </form>

                            </div>

                        </article>

                    </div>
                }


                @foreach (var movie in Model.AlreadyInLibrary)
                {
                    <div class="col">

                        <article class="movie-card">

                            <div class="movie-poster">

                                @if (!string.IsNullOrWhiteSpace(movie.Poster))
                                {
                                    <img src="@movie.Poster"
                                         alt="@movie.Title"
                                         loading="lazy" />
                                }
                                else
                                {
                                    <div class="movie-poster-placeholder">
                                        Pas d'affiche
                                    </div>
                                }

                            </div>

                            <div class="movie-info">

                                <h3 class="movie-title">
                                    @movie.Title
                                </h3>

                                <div class="movie-meta">

                                    <span>
                                        Déjà dans la bibliothèque
                                    </span>

                                    <span class="movie-rating">
                                        @movie.RatingTMDB.ToString("0.0") / 10
                                    </span>

                                </div>

                            </div>

                        </article>

                    </div>
                }

            </div>
        }
    }

</div>