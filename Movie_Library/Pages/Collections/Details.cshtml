@page "/Collections/{name}"
@model Movie_Library.Pages.Collections.DetailsModel

@{
    ViewData["Title"] =
        Model.CurrentCollection?.Name
        ?? "Collection";
}


<div class="container py-5">


    <!-- =====================================================
         RETOUR
         ===================================================== -->

    <div class="mb-4">

        <a asp-page="/Collections/Index"
           class="btn btn-outline-secondary">

            ← Retour aux collections

        </a>

    </div>


    <!-- =====================================================
     INFORMATIONS + MODIFICATION DE LA COLLECTION
     ===================================================== -->

    <section class="mb-5">
    
        <div class="row g-5 align-items-start">
    
    
            <!-- =================================================
                 COLONNE GAUCHE : INFORMATIONS DE LA COLLECTION
                 ================================================= -->
    
            <div class="col-12 col-lg-5">
    
                <div class="row align-items-center g-4">
    
                    <!-- POSTER -->
                    <div class="col-12 col-sm-5">
    
                        <div class="movie-poster">
    
                            @if (!string.IsNullOrWhiteSpace(
                                Model.CurrentCollection!.Poster))
                            {
                                <img src="@Model.CurrentCollection.Poster"
                                     alt="Poster de @Model.CurrentCollection.Name" />
                            }
                            else
                            {
                                <div class="movie-poster-placeholder">
    
                                    Pas de poster
    
                                </div>
                            }
    
                        </div>
    
                    </div>
    
    
                    <!-- INFORMATIONS -->
                    <div class="col">
    
                        <span class="home-kicker">
                            Collection
                        </span>
    
                        <h1 class="display-5 fw-bold">
                            @Model.CurrentCollection!.Name
                        </h1>
    
                        <p class="text-muted mb-0">
                            @Model.CurrentCollection.Movies.Count film(s)
                        </p>
    
                    </div>
    
                </div>
    
            </div>
    
    
            <!-- =================================================
                 COLONNE DROITE : MODIFICATION
                 ================================================= -->
    
            <div class="col-12 col-lg-7">
    
                <div class="collection-edit-panel">
    
                    <h2 class="h4 mb-4">
                        Modifier la collection
                    </h2>
    
    
                    <form method="post"
                          asp-page-handler="UpdateCollection">
    
    
                        <!-- Ancien nom -->
                        <input type="hidden"
                               asp-for="OriginalCollectionName" />
    
    
                        <!-- NOM -->
                        <div class="mb-3">
    
                            <label asp-for="EditCollectionName"
                                   class="form-label">
    
                                Nom de la collection
    
                            </label>
    
                            <input asp-for="EditCollectionName"
                                   class="form-control"
                                   autocomplete="off" />
    
                            <span asp-validation-for="EditCollectionName"
                                  class="text-danger">
                            </span>
    
                        </div>
    
    
                        <!-- POSTER -->
                        <div class="mb-3">
    
                            <label asp-for="EditCollectionPoster"
                                   class="form-label">
    
                                URL du poster
    
                            </label>
    
                            <input asp-for="EditCollectionPoster"
                                   class="form-control"
                                   placeholder="https://exemple.com/poster.jpg"
                                   autocomplete="off" />
    
                            <span class="form-text">
                                Laissez vide si la collection n'a pas de poster.
                            </span>
    
                        </div>
    
    
                        <!-- BOUTON -->
                        <button type="submit"
                                class="btn btn-primary">
    
                            Enregistrer les modifications
    
                        </button>
    
                    </form>
    
                </div>
    
            </div>
    
        </div>
    
    </section>


    <!-- =====================================================
     FILMS DÉJÀ PRÉSENTS DANS LA COLLECTION
     ===================================================== -->

    <section class="mb-5">
    
        <h2 class="h4 mb-4">
            Films de la collection
        </h2>
    
    
        @if (Model.CurrentCollection!.Movies.Count == 0)
        {
            <!--
                Aucun film n'a encore été ajouté
                à cette collection.
            -->
            <div class="library-empty">
    
                <p class="mb-0">
                    Aucun film dans cette collection.
                </p>
    
            </div>
        }
        else
        {
            <!--
                On réutilise volontairement la même grille
                que celle de la page Bibliothèque.
    
                Cela permet d'avoir exactement la même
                présentation visuelle.
            -->
            <div id="movie-grid"
                 class="row row-cols-2 row-cols-md-3 row-cols-lg-4 row-cols-xl-5 g-4 movie-grid">
            
                @foreach (var movie in Model.CurrentCollection.Movies)
                {
                    <!--
                        movie-item est important :
                        library.js recherche les éléments possédant
                        cette classe lorsqu'on clique sur un film.
            
                        Les attributs data-* contiennent les informations
                        nécessaires pour remplir la modale.
                    -->
                    <div class="col movie-item"
                         role="button"
                         tabindex="0"
                         aria-label="Afficher le film @movie.Title"
            
                         data-movie-id="@movie.Id"
                         data-title="@movie.Title"
                         data-synopsis="@movie.Synopsis"
                         data-poster="@movie.Poster"
            
                         data-status="@movie.Status.ToString().ToLowerInvariant()"
            
                         data-rating="@movie.RatingTMDB.ToString(
                             System.Globalization.CultureInfo.InvariantCulture
                         )"
            
                         data-personal-rating="@movie.PersonalRating.ToString(
                             System.Globalization.CultureInfo.InvariantCulture
                         )"
            
                         data-personal-note="@movie.PersonalNote">
            
            
                        <article class="movie-card">
            
                            <!-- AFFICHE -->
                            <div class="movie-poster">
            
                                @if (!string.IsNullOrWhiteSpace(movie.Poster))
                                {
                                    <img src="@movie.Poster"
                                         alt="@movie.Title"
                                         loading="lazy" />
                                }
                                else
                                {
                                    <div class="movie-poster-placeholder">
                                        Pas d'affiche
                                    </div>
                                }
            
                            </div>
            
            
                            <!-- INFORMATIONS -->
                            <div class="movie-info">
            
                                <h3 class="movie-title">
                                    @movie.Title
                                </h3>
            
            
                                <div class="movie-meta">
            
                                    <span class="movie-status-label">
            
                                        @(
                                            movie.Status == Movie_Library.Classes.Status.NotSeen
                                                ? "Non vu"
                                                : movie.Status == Movie_Library.Classes.Status.InProgress
                                                    ? "En cours"
                                                    : "Vu"
                                        )
            
                                    </span>
            
            
                                    @if (movie.RatingTMDB > 0)
                                    {
                                        <span class="movie-rating">
            
                                            @movie.RatingTMDB.ToString("0.0") / 10
            
                                        </span>
                                    }
            
                                </div>
            
            
                                @if (movie.PersonalRating > 0)
                                {
                                    <p class="movie-personal-rating">
            
                                        <span>
                                            Note personnelle :
                                        </span>
            
                                        <span>
                                            @movie.PersonalRating.ToString("0.0") / 10
                                        </span>
            
                                    </p>
                                }
            
                            </div>
            
                        </article>
            
                    </div>
                }
            
            </div>
        }
    
    </section>


    <!-- =====================================================
         AJOUT DE FILMS
         ===================================================== -->

    <section>

        <h2 class="h4 mb-4">
            Ajouter des films
        </h2>


        @if (Model.LibraryMovies.Count == 0)
        {
            <div class="alert alert-info">

                Aucun film n'est actuellement présent
                dans la bibliothèque.

            </div>
        }

        else if (Model.AvailableMovies.Count == 0)
        {
            <div class="alert alert-info">

                Tous les films de la bibliothèque sont déjà
                présents dans cette collection.

            </div>
        }

        else
        {
            <form method="post"
                  asp-page-handler="AddMovies">


                <!--
                    Permet de conserver le nom de la collection
                    lors de l'envoi du formulaire.
                -->
                <input type="hidden"
                       asp-for="CollectionName" />


                <!-- Erreur si aucun film n'est sélectionné. -->
                <span asp-validation-for="SelectedMovieIds"
                      class="text-danger d-block mb-3">
                </span>


                <div class="row g-3">

                    @foreach (var movie
                        in Model.AvailableMovies)
                    {
                        <div class="col-12 col-md-6">

                            <div class="form-check border rounded p-3">

                                <!--
                                    Toutes les checkboxes possèdent
                                    le même nom.

                                    ASP.NET Core construira alors
                                    automatiquement :

                                    List<int> SelectedMovieIds
                                -->
                                <input
                                    class="form-check-input"
                                    type="checkbox"
                                    name="SelectedMovieIds"
                                    value="@movie.Id"
                                    id="movie-@movie.Id" />


                                <label
                                    class="form-check-label"
                                    for="movie-@movie.Id">

                                    <strong>
                                        @movie.Title
                                    </strong>

                                </label>

                            </div>

                        </div>
                    }

                </div>


                <div class="mt-4">

                    <button type="submit"
                            class="btn btn-primary">

                        Ajouter les films sélectionnés

                    </button>

                </div>

            </form>
        }

    </section>


</div>

<!-- =====================================================
     MODALE DE GESTION DU FILM
     ===================================================== -->

<div class="modal fade"
     id="movie-details-modal"
     tabindex="-1"
     aria-labelledby="movie-modal-title"
     aria-hidden="true"

     data-save-url="@Url.Page("/Library/Index", "SaveDetails")"

     data-delete-url="@Url.Page(
         "/Collections/Details",
         "RemoveMovie",
         new
         {
             name = Model.CurrentCollection!.Name
         }
     )"

     data-delete-target="cette collection"

     data-delete-reload="true">


    <div class="modal-dialog modal-lg modal-dialog-centered modal-dialog-scrollable">

        <div class="modal-content movie-modal-content">


            <!-- =================================================
                 EN-TÊTE
                 ================================================= -->

            <div class="modal-header">

                <div>

                    <span class="home-kicker">
                        Gestion du film
                    </span>

                    <h2 class="modal-title h3"
                        id="movie-modal-title">
                    </h2>

                </div>


                <button type="button"
                        class="btn-close"
                        data-bs-dismiss="modal"
                        aria-label="Fermer">
                </button>

            </div>


            <!-- =================================================
                 CONTENU
                 ================================================= -->

            <div class="modal-body">


                <!-- Message après sauvegarde -->
                <div id="movie-modal-message"
                     class="alert d-none"
                     role="status"
                     aria-live="polite">
                </div>


                <!--
                    Protection contre les requêtes POST frauduleuses.

                    library.js récupère ce token lorsqu'il envoie
                    les modifications au backend.
                -->
                @Html.AntiForgeryToken()


                <div class="row g-4">


                    <!-- AFFICHE -->
                    <div class="col-12 col-sm-4">

                        <div class="movie-poster">

                            <img id="movie-modal-poster"
                                 src=""
                                 alt=""
                                 loading="lazy" />


                            <div id="movie-modal-no-poster"
                                 class="movie-poster-placeholder d-none">

                                Pas d'affiche

                            </div>

                        </div>

                    </div>


                    <!-- INFORMATIONS -->
                    <div class="col-12 col-sm-8">


                        <!-- NOTE TMDB -->
                        <div class="movie-modal-rating mb-3">

                            <span class="movie-rating">
                                Note TMDB
                            </span>

                            <strong id="movie-modal-tmdb-rating">
                            </strong>

                        </div>


                        <!-- STATUT -->
                        <h3 class="h5">
                            Statut du visionnage
                        </h3>

                        <select id="movie-modal-status"
                                class="form-select mb-4">

                            <option value="NotSeen">
                                Non vu
                            </option>

                            <option value="InProgress">
                                En cours
                            </option>

                            <option value="Seen">
                                Vu
                            </option>

                        </select>


                        <!-- SYNOPSIS -->
                        <h3 class="h5">
                            Synopsis
                        </h3>

                        <p id="movie-modal-synopsis">
                        </p>

                    </div>

                </div>


                <hr class="my-4" />


                <!-- =================================================
                     NOTE PERSONNELLE
                     ================================================= -->

                <div class="mb-3">

                    <label for="movie-modal-personal-rating"
                           class="form-label">

                        Ma note personnelle sur 10

                    </label>


                    <input id="movie-modal-personal-rating"
                           type="number"
                           class="form-control"
                           min="0"
                           max="10"
                           step="0.5"
                           value="0" />

                </div>


                <!-- =================================================
                     COMMENTAIRE PERSONNEL
                     ================================================= -->

                <div class="mb-3">

                    <label for="movie-modal-personal-note"
                           class="form-label">

                        Mes notes personnelles

                    </label>


                    <textarea id="movie-modal-personal-note"
                              class="form-control"
                              rows="4"
                              placeholder="Écris tes impressions sur ce film...">
                    </textarea>

                </div>

            </div>


            <!-- =================================================
                 BOUTONS
                 ================================================= -->

            <div class="modal-footer justify-content-between">


                <button type="button"
                        id="movie-modal-delete"
                        class="btn btn-outline-danger">

                    Retirer de la collection

                </button>


                <div class="d-flex gap-2">

                    <button type="button"
                            class="btn btn-outline-secondary"
                            data-bs-dismiss="modal">

                        Fermer

                    </button>


                    <button type="button"
                            id="movie-modal-save"
                            class="btn btn-primary">

                        Enregistrer

                    </button>

                </div>

            </div>

        </div>

    </div>

</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />

    <!--
        Réutilisation du JavaScript de la bibliothèque.

        Il gère :
        - le clic sur un film ;
        - l'ouverture de la modale ;
        - l'affichage des informations ;
        - la modification du statut ;
        - la note personnelle ;
        - les notes personnelles.
    -->
    <script src="~/js/library.js"
            asp-append-version="true">
    </script>
}