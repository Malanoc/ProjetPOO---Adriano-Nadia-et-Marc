@page
@model IndexModel

@{
    ViewData["Title"] = "Accueil";
}

<div class="home-page">

    <!-- Hero -->
    <section class="home-hero py-5">

        <div class="container py-4">

            <div class="row align-items-center g-5">

                <div class="col-12 col-lg-7">

                    <span class="badge text-bg-primary mb-3">
                        Votre bibliothèque de films
                    </span>

                    <h1 class="display-3 fw-bold mb-3">
                        Tous vos films,
                        <span class="text-primary">au même endroit.</span>
                    </h1>

                    <p class="lead mb-4">
                        Recherchez des films, ajoutez-les à votre bibliothèque,
                        suivez votre progression et organisez vos collections.
                    </p>

                    <div class="d-flex flex-wrap gap-2">

                        <a asp-page="/Movies/Index"
                           class="btn btn-primary btn-lg">
                            Rechercher un film
                        </a>

                        <a asp-page="/Library/Index"
                           class="btn btn-outline-secondary btn-lg">
                            Ma bibliothèque
                        </a>

                    </div>

                </div>

                <div class="col-12 col-lg-5">

                    <div class="home-hero-card">

                        <div class="feature-accent"></div>

                        <h2 class="h4 fw-bold mb-3">
                            Votre cinémathèque personnelle
                        </h2>

                        <p class="mb-0">
                            Retrouvez facilement les films que vous souhaitez voir,
                            ceux que vous avez déjà regardés et ceux que vous êtes
                            actuellement en train de découvrir.
                        </p>

                    </div>

                </div>

            </div>

        </div>

    </section>


    <!-- Fonctionnalités -->
    <section class="container py-5">

        <div class="text-center mb-5">

            <div class="feature-accent mx-auto"></div>

            <h2 class="fw-bold">
                Gérez votre bibliothèque simplement
            </h2>

            <p class="mt-3 mb-0">
                Les fonctionnalités essentielles pour organiser votre collection de films.
            </p>

        </div>


        <div class="row g-4">

            <div class="col-12 col-md-6 col-lg-3">

                <div class="home-feature-card h-100">

                    <div class="feature-accent"></div>

                    <h3 class="h5 fw-bold">
                        Rechercher
                    </h3>

                    <p class="mb-0">
                        Trouvez rapidement des films grâce aux informations
                        fournies par TMDB.
                    </p>

                </div>

            </div>


            <div class="col-12 col-md-6 col-lg-3">

                <div class="home-feature-card h-100">

                    <div class="feature-accent"></div>

                    <h3 class="h5 fw-bold">
                        Bibliothèque
                    </h3>

                    <p class="mb-0">
                        Conservez vos films et retrouvez-les rapidement
                        dans votre bibliothèque personnelle.
                    </p>

                </div>

            </div>


            <div class="col-12 col-md-6 col-lg-3">

                <div class="home-feature-card h-100">

                    <div class="feature-accent"></div>

                    <h3 class="h5 fw-bold">
                        Suivi du visionnage
                    </h3>

                    <p class="mb-0">
                        Indiquez simplement si un film est vu, non vu
                        ou actuellement en cours.
                    </p>

                </div>

            </div>


            <div class="col-12 col-md-6 col-lg-3">

                <div class="home-feature-card h-100">

                    <div class="feature-accent"></div>

                    <h3 class="h5 fw-bold">
                        Collections
                    </h3>

                    <p class="mb-0">
                        Organisez vos films dans des collections adaptées
                        à vos envies.
                    </p>

                </div>

            </div>

        </div>

    </section>


    <!-- Accès rapides -->
    <section class="container pb-5">

        <div class="home-quick-access">

            <div>

                <h2 class="h4 fw-bold mb-2">
                    Commencer maintenant
                </h2>

                <p class="mb-0">
                    Recherchez un film ou consultez les films déjà enregistrés.
                </p>

            </div>

            <div class="d-flex flex-wrap gap-2">

                <a asp-page="/Movies/Index"
                   class="btn btn-primary">
                    Rechercher
                </a>

                <a asp-page="/Library/Index"
                   class="btn btn-outline-primary">
                    Bibliothèque
                </a>

            </div>

        </div>

    </section>

</div>