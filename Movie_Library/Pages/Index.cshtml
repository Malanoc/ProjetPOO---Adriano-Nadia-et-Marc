@page
@model IndexModel
@{
    ViewData["Title"] = "Accueil";
}

<div class="p-5 mb-4 bg-light rounded-3 shadow-sm">
    <div class="container-fluid py-3">
        <!-- Donnée venant du Backend C# -->
        <h1 class="display-5 fw-bold text-primary">@Model.MessageBienvenue</h1>
        <p class="col-md-8 fs-4">Cette page utilise C# pour la logique et Bootstrap 5 pour le design.</p>
        <button class="btn btn-dark btn-lg" type="button" id="helloButton">C# Demo @Model.ModalMessage</button>
    </div>
</div>

<!-- Modal -->
<div class="modal fade" id="helloModal" tabindex="-1" aria-labelledby="helloModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h1 class="modal-title fs-5" id="helloModalLabel">Message</h1>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                @Model.ModalMessage
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Fermer</button>
            </div>
        </div>
    </div>
</div>

<!-- Barre de navigation -->
<nav class="navbar navbar-expand-lg bg-body border-bottom sticky-top shadow-sm">
    <div class="container-fluid px-4">
        <a class="navbar-brand fw-bold text-primary" href="#">
            <i class="bi bi-film me-2"></i>Cinéthèque
        </a>

        <!-- Bouton mobile hamburger -->
        <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent">
            <span class="navbar-toggler-icon"></span>
        </button>

        <!-- Éléments de la navbar -->
        <div class="collapse navbar-collapse mt-3 mt-lg-0" id="navbarContent">
            <!-- Barre de recherche et Filtre -->
            <div class="d-flex flex-column flex-lg-row align-items-lg-center gap-2 ms-auto me-lg-3 w-100 w-lg-auto">
                <div class="input-group">
                    <span class="input-group-text bg-transparent"><i class="bi bi-search"></i></span>
                    <input type="text" class="form-control" placeholder="Rechercher un film...">
                </div>
                
                <select class="form-select w-auto" aria-label="Filtrer les films">
                    <option selected>Tout</option>
                    <option value="non-vu">Non vu</option>
                    <option value="en-cours">En cours</option>
                    <option value="vu">Vu</option>
                </select>
            </div>

            <!-- Bouton Mode Clair / Sombre -->
            <div class="d-flex align-items-center mt-3 mt-lg-0">
                <button class="btn btn-outline-secondary rounded-circle p-2 lh-1" id="btn-theme-toggle" title="Changer de thème">
                    <i class="bi bi-sun-fill" id="theme-icon"></i>
                </button>
            </div>
        </div>
    </div>
</nav>

<!-- Contenu principal (Grille de films) -->
<main class="container my-4 flex-grow-1">
    <div class="d-flex align-items-center justify-content-between mb-4">
        <h1 class="h4 m-0 fw-semibold">Ma Collection</h1>
        <span class="text-muted small">4 films affichés</span>
    </div>

    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-xl-4 g-4">
        <!-- Film 1 -->
        <div class="col">
            <div class="card h-100 shadow-sm border-0">
                <img src="https://unsplash.com" class="card-img-top object-fit-cover" style="height: 280px;" alt="Affiche film">
                <div class="card-body d-flex flex-column">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <h5 class="card-title h6 fw-bold mb-0">Inception</h5>
                        <span class="badge bg-success-subtle text-success border border-success-subtle">Vu</span>
                    </div>
                    <p class="card-text text-muted small mb-3">Un voleur qui dérobe des secrets à travers les rêves...</p>
                    <button class="btn btn-sm btn-outline-primary mt-auto">Détails</button>
                </div>
            </div>
        </div>

        <!-- Film 2 -->
        <div class="col">
            <div class="card h-100 shadow-sm border-0">
                <img src="https://unsplash.com" class="card-img-top object-fit-cover" style="height: 280px;" alt="Affiche film">
                <div class="card-body d-flex flex-column">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <h5 class="card-title h6 fw-bold mb-0">Interstellar</h5>
                        <span class="badge bg-warning-subtle text-warning border border-warning-subtle">En cours</span>
                    </div>
                    <p class="card-text text-muted small mb-3">Les aventures d'un groupe d'explorateurs...</p>
                    <button class="btn btn-sm btn-outline-primary mt-auto">Détails</button>
                </div>
            </div>
        </div>

        <!-- Film 3 -->
        <div class="col">
            <div class="card h-100 shadow-sm border-0">
                <img src="https://unsplash.com" class="card-img-top object-fit-cover" style="height: 280px;" alt="Affiche film">
                <div class="card-body d-flex flex-column">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <h5 class="card-title h6 fw-bold mb-0">Matrix</h5>
                        <span class="badge bg-secondary-subtle text-secondary border border-secondary-subtle">Non vu</span>
                    </div>
                    <p class="card-text text-muted small mb-3">Un jeune hacker réalise que sa réalité est une simulation...</p>
                    <button class="btn btn-sm btn-outline-primary mt-auto">Détails</button>
                </div>
            </div>
        </div>

        <!-- Film 4 -->
        <div class="col">
            <div class="card h-100 shadow-sm border-0">
                <img src="https://unsplash.com" class="card-img-top object-fit-cover" style="height: 280px;" alt="Affiche film">
                <div class="card-body d-flex flex-column">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <h5 class="card-title h6 fw-bold mb-0">Gladiator</h5>
                        <span class="badge bg-success-subtle text-success border border-success-subtle">Vu</span>
                    </div>
                    <p class="card-text text-muted small mb-3">Le général romain Maximus est réduit en esclavage...</p>
                    <button class="btn btn-sm btn-outline-primary mt-auto">Détails</button>
                </div>
            </div>
        </div>
    </div>
</main>

<!-- Script pour le mode clair / sombre natif Bootstrap 5.3 -->
<script>
    const toggleBtn = document.getElementById('btn-theme-toggle');
    const themeIcon = document.getElementById('theme-icon');
    const htmlElement = document.documentElement;

    toggleBtn.addEventListener('click', () => {
        const currentTheme = htmlElement.getAttribute('data-bs-theme');
        const newTheme = currentTheme === 'dark' ? 'light' : 'dark';
        
        htmlElement.setAttribute('data-bs-theme', newTheme);
        
        if (newTheme === 'dark') {
            themeIcon.classList.replace('bi-sun-fill', 'bi-moon-fill');
        } else {
            themeIcon.classList.replace('bi-moon-fill', 'bi-sun-fill');
        }
    });

    document.getElementById('helloButton').addEventListener('click', function() {
        var modal = new bootstrap.Modal(document.getElementById('helloModal'));
        modal.show();
    });
</script>
