@page
@model Movie_Library.Pages.Library.IndexModel

@{
    ViewData["Title"] = "Ma bibliothèque";
}

<div class="library-page">

    <div class="container">

        <!-- HEADER -->

        <header class="library-header">

            <div>

                <span class="home-kicker">
                    Votre cinémathèque
                </span>

                <h1>
                    Ma bibliothèque
                </h1>

                <p>
                    Les films que vous avez décidé de garder.
                </p>

            </div>

            <div class="library-count">

                @Model.Library.Movies.Count
                film@(Model.Library.Movies.Count > 1 ? "s" : "")

            </div>

        </header>


        <!-- FILTRES -->

        <div class="library-toolbar">

            <div class="row g-3 align-items-end">

                <div class="col-12 col-md-6">

                    <label for="sort"
                           class="form-label">

                        Trier par

                    </label>

                    <select id="sort"
                            class="form-select">

                        <option value="title">
                            Titre
                        </option>

                        <option value="rating">
                            Note
                        </option>

                        <option value="status">
                            Statut
                        </option>

                    </select>

                </div>


                <div class="col-12 col-md-6">

                    <label for="status"
                           class="form-label">

                        Filtrer

                    </label>

                    <select id="status"
                            class="form-select">

                        <option value="all">
                            Tous les films
                        </option>

                        <option value="notseen">
                            Non vus
                        </option>

                        <option value="inprogress">
                            En cours
                        </option>

                        <option value="seen">
                            Vus
                        </option>

                    </select>

                </div>

            </div>

        </div>


        <!-- BIBLIOTHEQUE VIDE -->
        @if (Model.Library.Movies.Count == 0)
        {
            <div class="library-empty">

                <span class="home-kicker">
                    Aucun film
                </span>

                <h2>
                    Votre bibliothèque est encore vide.
                </h2>

                <p>
                    Recherchez un film pour commencer à construire
                    votre propre cinémathèque.
                </p>

                <a asp-page="/Movies/Index"
                   class="btn btn-primary">

                    Rechercher un film

                </a>

            </div>
        }
        else
        {

            <!-- FILMS -->

            <div id="movie-grid"
                 class="row row-cols-2 row-cols-md-3 row-cols-lg-4 row-cols-xl-5 g-4 movie-grid">

                @foreach (var movie in Model.Library.Movies)
                {

                    <div class="col movie-item"
                         data-title="@movie.Title"
                         data-status="@movie.Status.ToString().ToLowerInvariant()">

                        <article class="movie-card">

                            <div class="movie-poster">

                                @if (!string.IsNullOrWhiteSpace(movie.Poster))
                                {
                                    <img src="@movie.Poster"
                                         alt="@movie.Title"
                                         loading="lazy" />
                                }
                                else
                                {
                                    <div class="movie-poster-placeholder">
                                        Pas d'affiche
                                    </div>
                                }

                            </div>


                            <div class="movie-info">

                                <h2 class="movie-title">
                                    @movie.Title
                                </h2>

                                <div class="movie-meta">

                                    <span>
                                        @movie.Status
                                    </span>

                                    @if (movie.RatingTMDB > 0)
                                    {
                                        <span class="movie-rating">
                                            @movie.RatingTMDB.ToString("0.0") / 10
                                        </span>
                                    }

                                </div>

                            </div>

                        </article>

                    </div>

                }

            </div>
        }

    </div>

</div>

@section Scripts {

    <script src="~/js/library.js"></script>

}